<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="sih_warehouse">

    <!-- ===================== Physics & System Plugins ===================== -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <!-- ===================== Scene & Ambient ===================== -->
    <scene>
      <ambient>0.4 0.4 0.45 1.0</ambient>
      <background>0.15 0.17 0.20 1.0</background>
      <shadows>true</shadows>
    </scene>

    <!-- Primary Overhead Light (Industrial High-Bay) -->
    <light type="directional" name="high_bay_main">
      <cast_shadows>true</cast_shadows>
      <pose>7.5 7.5 12 0 0 0</pose>
      <diffuse>0.92 0.90 0.85 1</diffuse>
      <specular>0.35 0.34 0.32 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.1 -0.9</direction>
    </light>

    <!-- Secondary Fill Light (softer, bluish cool tone) -->
    <light type="directional" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>7.5 7.5 10 0 0 0</pose>
      <diffuse>0.3 0.35 0.45 1</diffuse>
      <specular>0.05 0.05 0.08 1</specular>
      <attenuation>
        <range>500</range>
        <constant>0.95</constant>
        <linear>0.005</linear>
        <quadratic>0.0005</quadratic>
      </attenuation>
      <direction>0.4 -0.2 -0.85</direction>
    </light>

